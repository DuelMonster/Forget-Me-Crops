<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclusion filter for Forget-Me-Crops.

    EI_EXPOSE_REP on HarvestContext.getHoe():
      getHoe() returns the internal ItemStack reference intentionally.
      setHoe() and the constructor both copy defensively on write, so callers
      that only read the item are safe. Copying on every read would be
      prohibitively expensive in the hot scanning loop.
-->
<FindBugsFilter>
    <Match>
        <Class name="com.forgetmecrops.harvest.HarvestContext"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
